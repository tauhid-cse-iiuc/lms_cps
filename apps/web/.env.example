# ---------------------------------------------------------------------------
# Copy this file to .env.local and adjust.  Never commit .env.local.
# ---------------------------------------------------------------------------

# Where the Strapi backend lives, for calls made by the Next.js SERVER
# (Server Components and Route Handlers). Not exposed to the browser.
STRAPI_URL=http://localhost:1337

# There is deliberately no NEXT_PUBLIC_ equivalent. The browser never calls
# Strapi directly - it calls this application's Route Handlers and Server
# Components, which hold the access token and call Strapi themselves. Anything
# prefixed NEXT_PUBLIC_ would be inlined into the bundle sent to visitors, and
# nothing on that side needs the address.

# In production (Vercel) this is the Railway domain, e.g.
#   STRAPI_URL=https://lmscps-production.up.railway.app

# Offer the "Sign in with Google" button. Must match the API actually having
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET set - the two apps deploy separately
# and neither can read the other's environment. Offering the button without
# working credentials dead-ends the visitor on a Google error page.
GOOGLE_SIGNIN_ENABLED=true
