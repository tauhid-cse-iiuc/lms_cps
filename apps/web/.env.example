# ---------------------------------------------------------------------------
# Copy this file to .env.local and adjust.  Never commit .env.local.
# ---------------------------------------------------------------------------

# Where the Strapi backend lives, for calls made by the Next.js SERVER
# (Server Components and Route Handlers). Not exposed to the browser.
STRAPI_URL=http://localhost:1337

# Same address, but for calls made by the BROWSER.
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle sent to
# visitors, so treat it as public. Never put a secret behind this prefix.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# In production (Vercel) both are set to the Railway domain, e.g.
#   STRAPI_URL=https://lmscps-production.up.railway.app
#   NEXT_PUBLIC_STRAPI_URL=https://lmscps-production.up.railway.app
