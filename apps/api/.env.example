# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.  Never commit .env itself.
# Generate each secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets - all six are required, Strapi will not boot without them.
# IMPORTANT: set these ONCE per environment and never rotate them casually.
# Changing JWT_SECRET logs every user out; changing APP_KEYS breaks admin login.
APP_KEYS="key1,key2"
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database
# Local development uses SQLite - a single file, nothing to install.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (Railway) uses PostgreSQL instead. Set these there:
#   DATABASE_CLIENT=postgres
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway's filesystem is ephemeral, so SQLite would be wiped on every
# redeploy - hence a managed Postgres service in production.

# Comma-separated list of frontend origins allowed to call this API.
# Production value is the Vercel domain, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
