# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.  Never commit .env itself.
# Generate each secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets - all six are required, Strapi will not boot without them.
# IMPORTANT: set these ONCE per environment and never rotate them casually.
# Changing JWT_SECRET logs every user out; changing APP_KEYS breaks admin login.
APP_KEYS="key1,key2"
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database
# Local development uses SQLite - a single file, nothing to install.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (Railway) uses PostgreSQL instead. Set these there:
#   DATABASE_CLIENT=postgres
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway's filesystem is ephemeral, so SQLite would be wiped on every
# redeploy - hence a managed Postgres service in production.

# Comma-separated list of frontend origins allowed to call this API.
# Production value is the Vercel domain, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Web application" in the Google Cloud
# console, then register these two redirect URIs on it EXACTLY - a trailing
# slash or the wrong scheme is the usual cause of redirect_uri_mismatch:
#
#   <API_URL>/api/connect/google/callback     e.g. http://localhost:1337/api/connect/google/callback
#   <WEB_URL>/connect/google/redirect         e.g. http://localhost:3000/connect/google/redirect
#
# Leave these unset and Google sign-in stays switched off; the button is simply
# not offered. The provider is configured from these values on every boot, so a
# fresh database plus these variables is a working sign-in with no clicking in
# the admin panel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Strapi sends the browser after Google consent. Must be the frontend.
FRONTEND_URL=http://localhost:3000

# Which email domains may create an account with a PASSWORD, comma separated.
# Defaults to gmail.com,googlemail.com when unset.
#
# This does not apply to Google sign-in. By the time that callback runs Google
# has already authenticated the person and told us which address is theirs -
# including Workspace addresses on a company domain - so re-applying a gmail
# filter there would reject accounts that are better verified than any password
# sign-up.
SIGNUP_ALLOWED_DOMAINS=gmail.com,googlemail.com

# ---------------------------------------------------------------------------
# Email (Gmail SMTP)
# ---------------------------------------------------------------------------
# Drives two things: the confirmation link sent on sign-up, and the password
# reset link. Leave SMTP_USERNAME/SMTP_PASSWORD unset and BOTH stay switched
# off - email confirmation is not enabled, and sign-up keeps working without it.
# That is deliberate: confirmation with no working mailer would let people
# register into an account they could never sign in to.
#
# SMTP_PASSWORD is a Google APP PASSWORD, not the account password:
#   1. Turn on 2-Step Verification at myaccount.google.com/security
#   2. Create one at myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are ignored, keep the quotes off)
# The account password is rejected by Gmail with "Username and Password not
# accepted", which does not tell you that the app password was the missing part.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=

# What recipients see in the From line. Gmail rewrites the envelope sender to
# the authenticated account regardless, so EMAIL_FROM should be the same address
# as SMTP_USERNAME - a mismatch is what spam filters score against.
EMAIL_FROM=
EMAIL_FROM_NAME=LMS
EMAIL_REPLY_TO=
